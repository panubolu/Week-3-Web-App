# Copy this file to .env.local and fill in your own values.
# Never commit .env.local. Never put real secrets in this file.

# Supabase (safe to expose, because access rules protect the data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Anthropic (secret: server only, never use a NEXT_PUBLIC_ name)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-opus-5-5
